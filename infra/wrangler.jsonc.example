{
  // TEMPLATE ONLY: M0 must install/pin Wrangler, implement worker/index.ts and build dist first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptbook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  // Configure verified custom domain routes only after owner authorization.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/admin/*"]
  },
  "r2_buckets": [
    {"binding": "STAGING", "bucket_name": "promptbook-staging"},
    {"binding": "MEDIA", "bucket_name": "promptbook-media"}
  ],
  "vars": {
    "SITE_ORIGIN": "https://prompts.example.com",
    "MEDIA_BASE_URL": "https://media.example.com",
    "GITHUB_REPOSITORY": "OWNER/REPOSITORY",
    "GITHUB_BRANCH": "main",
    "R2_ACCOUNT_ID": "REPLACE_WITH_ACCOUNT_ID",
    "STAGING_BUCKET": "promptbook-staging",
    "MEDIA_BUCKET": "promptbook-media"
  }
  // JWT settings, owner email, GitHub PAT, S3 credentials, receipt HMAC are Secrets, not public vars.
}
