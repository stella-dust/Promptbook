---
import SiteLayout from "../layouts/SiteLayout.astro";
import GalleryCard from "../components/GalleryCard.astro";
import { published, site, taxonomy } from "../lib/content";
const models = [...new Set(published.map((e) => e.generation.modelLabel))];
---

<SiteLayout>
  <section class="intro">
    <div>
      <h1>好结果，值得留一份。</h1>
      <p>提示词、生成结果，还有那些刚刚好的细节。</p>
    </div>
    <div class="intro-note">
      A place for the
      <br />
      ideas worth keeping.
    </div>
  </section>
  <section aria-label="筛选记录" id="filters" hidden={published.length === 0}>
    <div class="filter-bar">
      <div class="tabs" aria-label="结果类型">
        {[
          ["", "全部"],
          ["image", "图片"],
          ["video", "视频"],
        ].map(([value, label]) => (
          <button data-kind-filter={value} aria-pressed={value === ""}>
            {label}
          </button>
        ))}
      </div>
      <div class="filter-tools">
        <label class="search">
          <span class="sr-only">搜索标题、Prompt 或模型</span>
          <input
            id="search"
            type="search"
            placeholder="搜索标题、Prompt 或模型…"
          />
        </label>
        <label>
          <span class="sr-only">模型</span>
          <select id="model">
            <option value="">所有模型</option>
            {models.map((m) => (
              <option>{m}</option>
            ))}
          </select>
        </label>
        <label>
          <span class="sr-only">排序</span>
          <select id="sort" class="sort">
            <option value="latest">↓ 最新</option>
            <option value="oldest">↑ 最早</option>
          </select>
        </label>
      </div>
    </div>
    <div class="categories">
      <button data-category-filter="" aria-pressed="true">
        所有分类
      </button>
      {taxonomy
        .filter((t) => published.some((e) => e.category === t.id))
        .map((t) => (
          <button data-category-filter={t.id} aria-pressed="false">
            {t.label}
          </button>
        ))}
      <span class="result-count" id="result-count" aria-live="polite">
        {published.length} 条记录
      </span>
    </div>
  </section>
  {published.length > 0 ? (
    <>
      <div class="gallery">
        {published.map((entry) => (
          <GalleryCard entry={entry} />
        ))}
      </div>
      <section class="no-results" id="no-results" hidden>
        <h2>这一页还没有找到。</h2>
        <p class="muted">试试另一个关键词，或清除筛选。</p>
        <button id="clear-filters">清除筛选</button>
      </section>
    </>
  ) : (
    <section class="empty">
      <div class="blank-page" aria-hidden="true"></div>
      <div>
        <h2>把第一份喜欢，留在这里。</h2>
        <p>
          一段提示词，一张真实的结果。
          <br />
          从这一页开始，慢慢收集值得再试一次的灵感。
        </p>
        <a class="button primary" href={`${site.base}/admin/new/`}>
          新建第一条记录 <span aria-hidden="true">↗</span>
        </a>
        <p>
          <small>
            仅维护者可发布。你也可以
            <a href={`${site.base}/contribute/`}>通过 GitHub 贡献</a>。
          </small>
        </p>
      </div>
    </section>
  )}
</SiteLayout>
