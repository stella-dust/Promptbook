# Server-side configuration only. Copy to .dev.vars, never commit credentials.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
OWNER_EMAIL=your-owner-email
GITHUB_TOKEN=single-repository-fine-grained-token
R2_ACCESS_KEY_ID=two-bucket-access-key
R2_SECRET_ACCESS_KEY=two-bucket-secret-key
UPLOAD_RECEIPT_SECRET=random-32-or-more-characters

# Enable only after Access, media domain and CI deployment are verified.
PUBLISH_ENABLED=false
